MUSCLEWIKI_API_KEY=replace_with_a_direct_api_key
MUSCLEWIKI_BASE_URL=https://api.musclewiki.com

# Supabase Auth + database for the admin dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public application origin used in password recovery links
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Preferred Supabase key name (the older ANON_KEY name is also supported)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
# Preferred for Supabase projects using the new key format (sb_secret_...)
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key
# Legacy name is still supported for older service_role JWTs
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=admin@example.com

# Cloudflare R2 primary exercise-media storage. Keep access keys server-only.
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET_NAME=noi-gym-exercise-media
# Public custom domain or the bucket's public r2.dev URL, without a trailing slash.
R2_PUBLIC_BASE_URL=https://media.example.com
# Comma-separated genders whose existing media has been verified on R2.
R2_MIGRATED_EXERCISE_GENDERS=male
# Comma-separated storage paths known to be unavailable in every media source.
# The application keeps their poster but suppresses broken video playback.
EXERCISE_MEDIA_UNAVAILABLE_PATHS=

# Optional S3-compatible backup, for example Backblaze B2.
MEDIA_BACKUP_S3_ENDPOINT=https://s3.region.backblazeb2.com
MEDIA_BACKUP_S3_REGION=region
MEDIA_BACKUP_S3_BUCKET_NAME=noi-gym-exercise-media-backup
MEDIA_BACKUP_S3_ACCESS_KEY_ID=replace_with_backup_access_key_id
MEDIA_BACKUP_S3_SECRET_ACCESS_KEY=replace_with_backup_secret_access_key
