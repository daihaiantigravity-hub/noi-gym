MUSCLEWIKI_API_KEY=replace_with_a_direct_api_key
MUSCLEWIKI_BASE_URL=https://api.musclewiki.com

# Supabase Auth + database for the admin dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
# Preferred for Supabase projects using the new key format (sb_secret_...)
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key
# Legacy name is still supported for older service_role JWTs
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=admin@example.com
