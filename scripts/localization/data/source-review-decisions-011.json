  "reviewedAt": "2026-10-23T09:21:05.702Z",
  "reviewMethod": "Reviewed the front and side videos for male and female variants of all six Pilates candidates in the local exercise detail page, capturing three time-separated full-page screenshots per gender route. Four source contradictions were resolved from the visible movement; two remain held because the available views do not establish exact setup/sequence.",
  "decisions": [
    {
      "exercise_id": "0d186026-7797-4ab8-93b1-25b162d38f23",
      "sourceName": "Long Arm Adduction Side Kneeling",
      "changeReason": "All four videos show an upright side-kneeling position and a hand holding a strap. They do not show the supporting hand-under-shoulder setup or a required overhead reach. Replace those unsupported positions with the visible upright kneel, strap hold, downward arm pull, and controlled return.",
      "before": [
        "Kneel sideways, supporting hand under shoulder, top arm reaching long overhead.",
        "Engage core, keep torso upright and shoulders stacked.",
        "Pull top arm down toward hip, using lats and obliques.",
        "Return arm overhead with control, maintaining balance and steady breathing."
      ],
      "after": [
        "Kneel sideways on the reformer carriage with your torso upright and hold the strap in your working hand.",
        "Engage your core and keep your shoulders stacked over your hips.",
        "Pull the working arm down toward your hip, using your lats and obliques.",
        "Return your arm to the starting reach with control, maintaining balance and steady breathing."
      ],
      "translation_decision": "ready"
    },
    {
      "exercise_id": "1018382d-bfe2-4f78-8b98-dc0e97c09d51",
      "sourceName": "Single Leg Bicycle",
      "changeReason": "The front and side videos for both genders show one leg extending while the opposite knee draws into tabletop, then the positions switch. Clarify the working-leg roles so the instruction does not call the same leg both working and non-working.",
      "before": [
        "Lie supine, one knee bent, opposite leg extended.",
        "Press through one leg. Simultaneously pull the raised leg up to a table top position.",
        "As you lower, bring your non-working leg back into extension."
      ],
      "after": [
        "Lie supine, one knee bent and the opposite leg extended.",
        "Press through the extended leg as you draw the opposite knee up to a tabletop position.",
        "Switch leg positions as you lower, extending the raised leg and bending the other knee."
      ],
      "translation_decision": "ready"
    },
    {
      "exercise_id": "b35700e9-f0e0-44cd-93d8-70ed4892ad2a",
      "sourceName": "Front Rowing Preps Straight Forward Seated",
      "changeReason": "The front and side videos for both genders show the arms starting extended beside the torso before reaching straight forward. They do not start with the hands at chest height or close to the ribs as the source text states.",
      "before": [
        "Sit tall with legs extended, arms holding straps at chest height.",
        "Start with elbows extended, hands close to ribs, shoulders relaxed.",
        "Extend arms straight forward, maintaining upright posture and core engagement."
      ],
      "after": [
        "Sit tall with your legs extended, holding the straps in both hands.",
        "Start with your elbows extended and hands beside your hips, shoulders relaxed.",
        "Reach both arms straight forward, maintaining upright posture and core engagement."
      ],
      "translation_decision": "ready"
    },
    {
      "exercise_id": "fdce9075-8080-41e9-9943-8cb4b4a8be70",
      "sourceName": "Side Splits Skating",
      "changeReason": "The front and side videos for both genders keep the torso hinged forward with a neutral spine during both the outward push and the return. The source's instruction to return while upright contradicts the movement shown.",
      "before": [
        "Stand on reformer, feet on platforms, hinged forward, spine neutral.",
        "Push carriage out.",
        "Return to center with control, maintaining upright posture."
      ],
      "after": [
        "Stand on the reformer with one foot on each platform, hinge forward, and keep your spine neutral.",
        "Push the carriage out to the side.",
        "Return the carriage to center with control while keeping your torso hinged forward and your spine neutral."
      ],
      "translation_decision": "ready"
    }
  ],
