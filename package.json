{
  "name": "noi-gym",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "test:health-background": "node --test tests/health-background.test.mjs",
    "test:pagination": "node --test tests/exercise-pagination.test.mjs",
    "seed:exercises": "node scripts/seed-exercises.mjs",
    "prepare:musclewiki-import": "node scripts/migration/convert-musclewiki-dom-to-import.mjs",
    "upload:musclewiki-media": "node scripts/migration/upload-musclewiki-media.mjs",
    "import:musclewiki-targets": "node scripts/migration/import-musclewiki-targets.mjs",
    "prepare:musclewiki-targets": "node scripts/migration/import-musclewiki-targets.mjs --prepare-only",
    "upload:musclewiki-targets": "node scripts/migration/upload-musclewiki-media.mjs --dataset scripts/migration/data/musclewiki-target-new-import.json --skip-unavailable",
    "migrate:media:r2": "node scripts/migration/migrate-supabase-media-to-s3.mjs",
    "migrate:media:musclewiki:r2": "node scripts/migration/migrate-musclewiki-media-to-r2.mjs",
    "migrate:media:musclewiki:r2:male": "node scripts/migration/migrate-musclewiki-media-to-r2.mjs --gender male",
    "migrate:media:musclewiki:r2:female": "node scripts/migration/migrate-musclewiki-media-to-r2.mjs --gender female",
    "migrate:posters:musclewiki:r2:male": "node scripts/migration/migrate-musclewiki-posters-to-r2.mjs --gender male",
    "migrate:posters:musclewiki:r2:female": "node scripts/migration/migrate-musclewiki-posters-to-r2.mjs --gender female",
    "restore:supabase:backup": "node scripts/migration/restore-supabase-backup.mjs",
    "migrate:musclewiki:biceps-dumbbells": "node scripts/migration/scrape-musclewiki-biceps-dumbbells.mjs",
    "migrate:musclewiki:biceps-dumbbells:browser": "node scripts/migration/scrape-musclewiki-biceps-dumbbells.mjs --browser"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.90.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
