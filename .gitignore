# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local headed migration browser profile
/scripts/migration/browser-profile/

# generated media migration manifests (contain object inventory and checksums)
/artifacts/media-migration/

# Generated localization snapshots, dry-run reports and import checkpoints.
/artifacts/localization/

# Generated performance measurements and local browser captures.
/artifacts/performance/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
